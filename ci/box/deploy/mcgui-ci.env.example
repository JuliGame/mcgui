# /etc/mcgui-ci.env: the bench box's own settings, read by install.sh and both pollers (EnvironmentFile=).
# Mode 600, root-owned, never committed. Copy this file there and fill in the paths of your box.

# --- server bench gate (server_bench.py, mcgui-server-bench.timer)
MCGUI_CI_REPO=resourcepack-ai/mcgui
# The promotion PR: head branch of MCGUI_CI_REPO itself into the base branch. The commit status context it posts.
MCGUI_CI_BASE=main
MCGUI_CI_HEAD=dev
MCGUI_CI_CONTEXT=server-bench
# The gh login (root's) whose token posts statuses and the PR comment.
MCGUI_CI_GH_USER=
MCGUI_CI_MAX_ATTEMPTS=3
# Locks the box's other users of Gradle and of timed JVMs take (flock(1) files); empty for none.
MCGUI_CI_BUILD_LOCK=
MCGUI_CI_JVM_LOCK=
# Arguments for bench/bench.py besides --no-build/--ports/--tag/--out (empty: the full bench; --quick for the short one).
MCGUI_CI_BENCH_ARGS=
# First of three ports (server, probe, pack), on 127.0.0.1 only.
MCGUI_CI_PORTS=25990
# The sandboxed bench unit's memory pair and time limits.
MCGUI_CI_MEMORY_HIGH=4608M
MCGUI_CI_MEMORY_MAX=5G
MCGUI_CI_BUILD_TIMEOUT=25min
MCGUI_CI_BENCH_TIMEOUT=40min
# How long to wait for a quiet box before a run counts as an infrastructure fault.
MCGUI_CI_GATE_MINUTES=30
MCGUI_CI_JAVA21=/usr/lib/jvm/java-21-openjdk-amd64
MCGUI_CI_JAVA25=/usr/lib/jvm/java-25-openjdk-amd64/bin/java

# --- install.sh only: where to copy the private Probe plugin jar and a Paper 26.2+ server folder that has run once from
MCGUI_CI_PROBE_SRC=
MCGUI_CI_SERVER_SRC=

# --- tag watcher (tag_watch.py, mcgui-tag-watch.timer)
# The Discord forum the build-and-publish request goes to, and the user it mentions.
MCGUI_CI_TAG_FORUM=
MCGUI_CI_TAG_MENTION=
# The Backchannel agent MCP server (stdio) and its config (the bot token lives there, never here).
MCGUI_CI_BACKCHANNEL_CMD=
MCGUI_CI_BACKCHANNEL_CONFIG=
MCGUI_CI_BACKCHANNEL_DENY_PATHS=
